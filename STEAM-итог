#include <SPI.h>
#include <MFRC522.h>
#include <Keypad.h>

// ================= RFID =================
#define SS_PIN1 8
#define SS_PIN2 10
#define RST_PIN1 9
#define RST_PIN2 11

MFRC522 rfid1(SS_PIN1, RST_PIN1);
MFRC522 rfid2(SS_PIN2, RST_PIN2);

// ================= MATRIX =================
#define DIN 48
#define CLK 49
#define CS  47

byte bufferM[8];      // основной буфер
byte overlayM[8];     // overlay (галочка, крест, стрелки, номер)

// для анимации прогресса
int animColumn = -1;      // текущий столбец прогресса
unsigned long animTime = 0;
bool animating = false;

void sendM(byte reg, byte data){
  digitalWrite(CS, LOW);
  shiftOut(DIN, CLK, MSBFIRST, reg);
  shiftOut(DIN, CLK, MSBFIRST, data);
  digitalWrite(CS, HIGH);
}

void drawMatrix(){
  byte finalM[8];
  for(int i=0;i<8;i++) finalM[i] = bufferM[i] | overlayM[i]; // overlay справа
  for(int i=0;i<8;i++) sendM(i+1, finalM[i]);
}

void clearBuffer(){
  for(int i=0;i<8;i++) bufferM[i]=0;
}

void clearOverlay(){
  for(int i=0;i<8;i++) overlayM[i]=0;
}

void matrixInit(){
  pinMode(DIN,OUTPUT);
  pinMode(CLK,OUTPUT);
  pinMode(CS,OUTPUT);

  sendM(0x0C,1);
  sendM(0x0B,7);
  sendM(0x0A,8);
  sendM(0x09,0);
  sendM(0x0F,0);

  clearBuffer();
  clearOverlay();
  drawMatrix();
}

// ================= UI =================
// запускаем анимацию прогресса
void startProgressAnim(int count){
  animColumn = -1;
  animating = true;
  animTime = millis();
}

// обновляем анимацию прогресса
void updateProgressAnim(int count){
  if(!animating) return;
  if(millis() - animTime > 100){  // шаг анимации 100 мс
    animColumn++;
    if(animColumn >= count){
      animating = false;
      animColumn = count-1;
    }
    clearBuffer();
    for(int i=0;i<=animColumn;i++){
      for(int row=7; row>=4; row--) bufferM[row] |= (1 << (5-i));
    }
    drawMatrix();
    animTime = millis();
  }
}

// галочка справа (столбцы 6-7)
void showOK(){
  byte d[8]={0,0,0,0,18,28,0,0};
  for(int i=0;i<8;i++) overlayM[i] = d[i]<<6;
  drawMatrix();
}

// крест справа
void showERR(){
  byte d[8]={0,0,0,36,24,36,0,0};
  for(int i=0;i<8;i++) overlayM[i] = d[i]<<6;
  drawMatrix();
}

// стрелка вниз — взять павер
void showTake(int slot){
  byte d[8]={0,24,24,24,24,126,24,0};
  for(int i=0;i<8;i++) overlayM[i] = d[i]<<6;
  drawMatrix();
  Serial.print("TAKE SLOT "); Serial.println(slot+1);
}

// стрелка вверх — вернуть павер
void showReturn(int slot){
  byte d[8]={0,24,126,24,24,24,24,0};
  for(int i=0;i<8;i++) overlayM[i] = d[i]<<6;
  drawMatrix();
  Serial.print("RETURN SLOT "); Serial.println(slot+1);
}

// номер слота 1–3 справа
byte num1[8]={0,24,56,24,24,24,126,0};
byte num2[8]={0,60,66,12,48,64,126,0};
byte num3[8]={0,60,66,12,2,66,60,0};

void showNumber(int n){
  byte* d = nullptr;
  if(n==1) d=num1;
  if(n==2) d=num2;
  if(n==3) d=num3;
  if(!d) return;

  for(int i=0;i<8;i++) overlayM[i] = d[i]<<6;
  drawMatrix();
}

// ================= КЛАВА =================
const byte ROWS=4, COLS=4;
char keys[ROWS][COLS]={
{'1','2','3','A'},
{'4','5','6','B'},
{'7','8','9','C'},
{'*','0','#','D'}
};
byte rowPins[ROWS]={2,3,4,5};
byte colPins[COLS]={6,A2,A1,A0};

Keypad keypad=Keypad(makeKeymap(keys),rowPins,colPins,ROWS,COLS);

String input="";

// ================= ЛОГИКА =================
#define NUM 3
bool slots[NUM];

struct User{
  String pass;
  int debt; // 0 = нет, 1 = есть
};

User users[2]={
  {"111111",0},
  {"123456",0}
};

int findFull(){
  for(int i=0;i<NUM;i++) if(slots[i]) return i;
  return -1;
}
int findEmpty(){
  for(int i=0;i<NUM;i++) if(!slots[i]) return i;
  return -1;
}

// ================= STATE MACHINE =================
enum AppState{
  STATE_IDLE,
  STATE_SHOW_OK,
  STATE_SHOW_ERR,
  STATE_SHOW_ACTION,
  STATE_SHOW_NUMBER
};

AppState state = STATE_IDLE;
unsigned long stateTime = 0;
int currentSlot = -1;
bool isTake = true;

// запуск процесса
void startProcess(bool take, int slot){
  isTake = take;
  currentSlot = slot;

  showOK();
  state = STATE_SHOW_OK;
  stateTime = millis();
}

void updateState(){
  unsigned long now = millis();
  switch(state){
    case STATE_SHOW_OK:
      if(now - stateTime > 100){
        if(isTake) showTake(currentSlot);
        else showReturn(currentSlot);
        state = STATE_SHOW_ACTION;
        stateTime = now;
      }
      break;

    case STATE_SHOW_ACTION:
      if(now - stateTime > 100){
        showNumber(currentSlot+1);
        state = STATE_SHOW_NUMBER;
        stateTime = now;
      }
      break;

    case STATE_SHOW_NUMBER:
      if(now - stateTime > 200){
        clearOverlay();
        drawMatrix();
        state = STATE_IDLE;
      }
      break;

    case STATE_SHOW_ERR:
      if(now - stateTime > 200){
        clearOverlay();
        drawMatrix();
        state = STATE_IDLE;
      }
      break;

    case STATE_IDLE: break;
  }
}

// обработка пароля
void process(String pass){
  Serial.println(pass);

  for(int i=0;i<2;i++){
    if(users[i].pass==pass){
      if(users[i].debt==0){
        int s=findFull();
        if(s==-1){
          showERR();
          state=STATE_SHOW_ERR;
          stateTime=millis();
          return;
        }

        slots[s]=false;
        users[i].debt=1;
        startProcess(true,s);
      }else{
        int s=findEmpty();
        if(s==-1){
          showERR();
          state=STATE_SHOW_ERR;
          stateTime=millis();
          return;
        }

        slots[s]=true;
        users[i].debt=0;
        startProcess(false,s);
      }
      return;
    }
  }

  showERR();
  state=STATE_SHOW_ERR;
  stateTime=millis();
}

// ================= RFID (только лог) =================
void pollRFID(){
  if(rfid1.PICC_IsNewCardPresent() && rfid1.PICC_ReadCardSerial()){
    Serial.println("RFID1");
    rfid1.PICC_HaltA();
    rfid1.PCD_StopCrypto1();
  }
  if(rfid2.PICC_IsNewCardPresent() && rfid2.PICC_ReadCardSerial()){
    Serial.println("RFID2");
    rfid2.PICC_HaltA();
    rfid2.PCD_StopCrypto1();
  }
}

// ================= SETUP =================
void setup(){
  Serial.begin(115200);

  SPI.begin();
  rfid1.PCD_Init();
  rfid2.PCD_Init();

  matrixInit();

  for(int i=0;i<NUM;i++) slots[i]=true;

  Serial.println("START");
}

// ================= LOOP =================
void loop(){
  pollRFID();
  updateState();
  updateProgressAnim(input.length()); // анимация прогресса

  char k=keypad.getKey();
  if(k && state==STATE_IDLE){
    if(k=='#'){
      input="";
      clearOverlay();
      clearBuffer();
      drawMatrix();
      animating = false;
    }else{
      input+=k;
      startProgressAnim(input.length());
    }

    if(input.length()==6){
      process(input);
      input="";
    }
  }
}
